{
  "name": "recipe-scraper-7400",
  "version": "1.1.0",
  "description": "Recipe scraper backend package with got+cheerio and puppeteer strategies, JSON-LD fallback, central schema, and SSRF-safe validation.",
  "author": "Justin Adkins <jadkins1019@gmail.com>",
  "license": "MIT",
  "keywords": [
    "recipes",
    "scraper",
    "web-scraper",
    "recipe",
    "cheerio",
    "puppeteer",
    "json-ld",
    "got"
  ],
  "main": "src/index.js",
  "types": "src/types.d.ts",
  "exports": {
    ".": {
      "require": "./src/index.js",
      "default": "./src/index.js",
      "types": "./src/types.d.ts"
    }
  },
  "scripts": {
    "test": "mocha --timeout 15000",
    "start": "node index.js",
    "coverage": "nyc npm test",
    "coveralls": "nyc npm test && nyc report --reporter=text-lcov | coveralls",
    "lint": "eslint \"src/**/*.js\"",
    "format": "prettier --write \"{src,scrapers}/**/*.js\"",
    "typecheck": "echo \"Type definitions provided via d.ts\""
  },
  "files": [
    "helpers/",
    "scrapers/",
    "src/",
    "LICENSE",
    "README.md",
    "index.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jadkins89/Recipe-Scraper.git"
  },
  "bugs": {
    "url": "https://github.com/jadkins89/Recipe-Scraper/issues"
  },
  "homepage": "https://github.com/jadkins89/Recipe-Scraper#readme",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "got": "^13.0.0",
    "puppeteer": "^22.6.0"
  },
  "devDependencies": {
    "chai": "^4.2.0",
    "coveralls": "^3.0.6",
    "mocha": "^6.2.1",
    "nyc": "^14.1.1",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3"
  }
}
